		(uuid "0e2afab7-78e4-48ad-820c-af7ac1db5ad9")
	)
	(text_box "CP2102N-A02-GQFN24R NOTES:\n- SUSPEND Digital Output: This pin is driven high when the device enters the USB suspend state.\n- USB Suspend State: hardware-driven, low-power mode defined by the official USB specification. It allows the host computer to put a USB peripheral into a \"deep sleep\" when the bus goes idle, drastically cutting power consumption without breaking the connection.\n  - Can only draw 300uA in USB suspend mode\n  - The CP2102N will enter USB SUSPEND mode when it stops receiving start-of-frame SOF notification from the USB host. If the host PC is configured not to go to SUSPEND mode it will kee sending SOF.\n  - Upon the USB SUSPEND MODE interrupt there is around 7mS to comply with the current requiremments. "
		(exclude_from_sim no)
		(at 20.32 153.67 0)
		(size 81.28 41.91)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type dash)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "128202e2-e053-45f5-906e-68d0c3e6c64d")
	)
