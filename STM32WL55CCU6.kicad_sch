	)
	(text "Clipped Sine Wave Oscillator\n- Series C eliminates DC component\n- MCU acciepots clock above zero so the \n  clock signal gets biased (increased)\n  inside the MCU."
		(exclude_from_sim no)
		(at 207.772 118.11 0)
