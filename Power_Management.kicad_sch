	(text_box "Polarity Protection, TVS"
		(exclude_from_sim no)
		(at 26.035 25.4 0)
		(size 227.965 54.61)
		(stroke
			(width 0)
			(type dash)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "647e553b-2c18-409b-b9e7-762a362ca472")
	)
	(text_box "Notes:\nThe plan for the popower input is to filter the USB VBUS using ferrite bead along with decoupling capacitors that will then supply a 3V3 LDO. The ouptut will supply VDD digital domain which will e filtered again using ferritte bead and decoupling capacitors before connecting to VDDA the annalog domain.\n\n- USB-C VBUS filtered using FB, C\n- LDO 3V3\n- Supply VDD  digital domain\n- Isolate digital domain switching from analog domain by filtering again using FB, C \n\nFerrite Beads\n- 600Ohm@100MHz Used for VBUS to isolate the voltage rail noise\n- 120Ohm@100MHz Used to isolate the VDD digital domain transients  "
		(exclude_from_sim no)
		(at 98.425 156.21 0)
		(size 53.975 36.195)
		(stroke
			(width 0)
			(type dash)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "7f50ce96-faeb-415b-9b35-cd57ad586fdc")
	)
	(text "Overvoltage protection\nfor the PMOSFET VGS\n(VGS max is 8V)"
		(exclude_from_sim no)
		(at 151.892 64.262 0)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "1bdac781-dce6-46cf-a8b5-aedd584575aa")
	)
	(text "EP is optional adhesive zone"
